APP_ENV=development
APP_URL=http://localhost:8000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gestor_proyectos
DB_USER=root
DB_PASS=

# Correo
# Con SMTP configurado se envía por SMTP; si no, se usa mail() del servidor.
# Si MAIL_ENABLED=false los mensajes se escriben en storage/mail.log (útil en local).
# MAIL_ENABLED se activa solo si hay SMTP_HOST; ponlo a false para desactivarlo.
MAIL_ENABLED=false
MAIL_FROM=no-reply@vertice.local
MAIL_FROM_NAME=Vértice

# Buzón que recibe las solicitudes del módulo Soporte (si está vacío se usa MAIL_FROM)
SUPPORT_EMAIL=

# SMTP (Hostinger: smtp.hostinger.com, puerto 465 con SSL)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# ssl | tls | none. Si se deja vacío se deduce del puerto (465=ssl, 587=tls)
SMTP_SECURE=

# Landing pública
CONTACT_EMAIL=
WHATSAPP_NUMBER=
DEMO_NOTIFY_EMAIL=

# Inicio de sesión con Google (OAuth 2.0 / OpenID Connect)
# 1. Crea un cliente OAuth en https://console.cloud.google.com/apis/credentials
# 2. Añade como URI de redirección autorizada: https://tu-dominio.com/google-callback
# 3. Copia aquí el Client ID y el Client Secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional. Por defecto se usa APP_URL/google-callback.
GOOGLE_REDIRECT_URI=
